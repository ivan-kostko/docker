# docker/base/Dockerfile.alpine
# Pinned by digest; the tag is kept for readability. Update with
# scripts/update-base-images.sh (docs/reproducibility.md).
ARG BASE_IMAGE="alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0"
FROM ${BASE_IMAGE} AS devbase

ARG USER_UID=1000
ARG USER_NAME=vscode

# Busybox ash doesn't support `-o pipefail`, unlike bash — keep the
# Dockerfile's own SHELL minimal. Scripts we COPY in still declare
# `#!/usr/bin/env bash` and get bash's stricter behavior once bash is
# installed below and invoked via their own shebang.
SHELL ["/bin/sh", "-eu", "-c"]

COPY packages-alpine.txt /tmp/packages.txt
RUN apk update \
    && apk upgrade --no-cache \
    && grep -Ev '^\s*#|^\s*$' /tmp/packages.txt | xargs apk add --no-cache \
    && rm -f /tmp/packages.txt \
    && adduser -D -s /usr/bin/zsh -u "${USER_UID}" "${USER_NAME}" \
    && echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USER_NAME} \
    && chmod 0440 /etc/sudoers.d/${USER_NAME} \
    && install -d -o "${USER_NAME}" /usr/local/share/dev-base

USER $USER_NAME

# Reproducibility: immutable commit of romkatv/powerlevel10k-media (was the
# moving `master` branch). Content is identical to master at the time of pinning.
ARG P10K_MEDIA_REF=145eb9fbc2f42ee408dacd9b22d8e6e0e553f83d

ADD --chown=${USER_NAME} https://gist.githubusercontent.com/ivan-kostko/2356a782a40be65b432a9fdbc67845cd/raw/59468eb3935bf1141437d96d3dfcecef277c4331/p10k.zsh /home/$USER_NAME/.p10k.zsh
ADD --chown=${USER_NAME} https://github.com/romkatv/powerlevel10k-media/raw/${P10K_MEDIA_REF}/MesloLGS%20NF%20Regular.ttf /home/$USER_NAME/.fonts/
ADD --chown=${USER_NAME} https://github.com/romkatv/powerlevel10k-media/raw/${P10K_MEDIA_REF}/MesloLGS%20NF%20Bold.ttf /home/$USER_NAME/.fonts/
ADD --chown=${USER_NAME} https://github.com/romkatv/powerlevel10k-media/raw/${P10K_MEDIA_REF}/MesloLGS%20NF%20Italic.ttf /home/$USER_NAME/.fonts/
ADD --chown=${USER_NAME} https://github.com/romkatv/powerlevel10k-media/raw/${P10K_MEDIA_REF}/MesloLGS%20NF%20Bold%20Italic.ttf /home/$USER_NAME/.fonts/

# Accepted mutable inputs: CI resolves these to explicit revisions and passes
# them in; when empty (local builds) upstream "latest"/`master` is used.
ARG OMZ_REF=""
ARG P10K_REF=""
COPY --chown=${USER_NAME} --chmod=0755 setup.sh /tmp/setup.sh
RUN /tmp/setup.sh $USER_NAME

ARG CLAUDE_CODE_VERSION=""
ARG CODEX_VERSION=""
COPY --chown=${USER_NAME} --chmod=0755 install-ai-clis.sh /tmp/install-ai-clis.sh
RUN /tmp/install-ai-clis.sh $USER_NAME

# Record what was actually installed (documented in docs/product-contract.md).
COPY --chown=${USER_NAME} --chmod=0755 write-build-info.sh /tmp/write-build-info.sh
RUN /tmp/write-build-info.sh
