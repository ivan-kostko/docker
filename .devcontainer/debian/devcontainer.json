{
  "name": "Docker Debian Dev",
  // Extras image (extras/Dockerfile.debian) = published dev-base product image +
  // this repo's dev tools (pre-commit, linters, scanners, pre-warmed hooks).
  // Never the raw product image. To try local dev-base changes, tag a local
  // product build as ghcr.io/ivan-kostko/dev-base:debian first (docs/images.md).
  "build": {
    "dockerfile": "../../extras/Dockerfile.debian",
    "context": "../..",
    "args": {
      "BASE_IMAGE": "ghcr.io/ivan-kostko/dev-base:debian"
    }
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,   // this is the default, but explicit is clearer here
  "runArgs": [
    "--security-opt", "seccomp=unconfined"
  ],
  "features": {
    // Gives the container a `docker` CLI wired to the HOST's Docker daemon,
    // so `docker build` / `docker buildx bake` inside this devcontainer
    // actually build and are visible to `docker images` on your host too.
    // No nested daemon, no extra resource overhead.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "containerEnv": {},
  "initializeCommand": "mkdir -p \"$HOME/.ssh\" \"$HOME/.claude\" \"$HOME/.codex\" && touch \"$HOME/.claude.json\"",
  "mounts": [
    // SSH keys
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
    // Git config
    // NB: ~/.gitconfig is magicly mounted into /home/vscode/ by VSCode. No real need to mount it separately.
    // !!!!!!!!!!!!!!!!!!!!!!
    // Uncomment and edit next line if you have imports in your ~/.gitconfig
    // "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig-myown,target=/home/vscode/.gitconfig-myown,type=bind,consistency=cached",
    // GPG keys
    // No point to play sandbox - just mount whole folder!
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gnupg/,target=/home/vscode/.gnupg/,type=bind",
    // ZSH history
    "source=${localWorkspaceFolder}/.devcontainer/.zsh_history,target=/home/vscode/.zsh_history,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
    // Codex CLI credentials + config (~/.codex): same host directory as on the
    // host itself, so it syncs across devices (via whatever syncs your home
    // directory) and behaves the same in every dev container, like ~/.claude.
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached"
  ],
  "postStartCommand": "pre-commit install",
    "customizations": {
      "vscode": {
        "extensions": [
          "streetsidesoftware.code-spell-checker",
          "shardulm94.trailing-spaces",
          "ms-vscode-remote.remote-containers",
          "ms-azuretools.vscode-docker",
          "adamhartford.vscode-base64",
          "redhat.vscode-yaml",
          "ms-vscode.makefile-tools",
          "formulahendry.docker-extension-pack",
          "henriiik.docker-linter",
          "yzane.markdown-pdf",
          "breaking-point.vsc-postman",
          "Anthropic.claude-code",
          "openai.chatgpt",
          "dbaeumer.vscode-eslint"
        ],
        "settings": {
          "terminal.integrated.defaultProfile.linux": "zsh",
          "terminal.integrated.profiles.linux": {
          "bash": null
        },
        "terminal.integrated.fontFamily": "MesloLGS NF, Regular"
      }
    }
  }
}
